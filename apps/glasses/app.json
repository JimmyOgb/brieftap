{
  "package_id": "com.brieftap.app",
  "edition": "202601",
  "name": "BriefTap",
  "version": "0.1.0",
  "min_app_version": "2.0.0",
  "min_sdk_version": "0.0.12",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Connects to BriefTap backend and Telegram bridge",
      "whitelist": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:3001",
        "http://127.0.0.1:3001",
        "https://brieftap.vercel.app",
        "https://brieftap.onrender.com"
      ]
    },
    {
      "name": "g2-microphone",
      "desc": "Transcribes 16kHz voice intents using G2 microphone"
    }
  ],
  "supported_languages": [
    "en"
  ]
}
